  | kasina (n : Nat) | asubha (n : Nat) | anussati (n : Nat) | appamanna (n : Nat) | sanna | vavatthana | aruppa (n : Nat)
  deriving DecidableEq, Repr

/-- What a world has, kind by kind. Nothing here fixes a count; the rows below do. -/
structure Tax where
  /-- the citta-types, in the 121 reckoning (each supramundane citta by its jhāna) -/
  kinds : List Citta
  /-- the cetasikas -/
  cets : List Cetasika
  /-- which cetasika arises in which citta-type -/
  assoc : Citta → Cetasika → Bool
  /-- which function a citta-type performs -/
  kicca : Citta → Kicca → Bool
  /-- which citta-types can occur as a super-knowledge -/
  abhinna : Citta → Bool
  /-- which objects a citta-type takes; the Bool is true when it occurs as a super-knowledge (§58–59 count those apart) -/
  scope : Citta → Bool → Obj → Bool
  /-- the ultimate entities with their own characteristic -/
  salakkhana : List Dhamma
  /-- the kinds of matter -/
  rupas : List Rupa
  /-- which kinds are concretely produced -/
  nipphanna : Rupa → Bool
  /-- matter's dyads -/
  internal : Rupa → Bool
  gross : Rupa → Bool
  clung : Rupa → Bool
  visible : Rupa → Bool
  /-- which origin can produce which kind -/
  origin : Rupa → Origin → Bool
  /-- three dyads named without members -/
  base : Rupa → Bool
  door : Rupa → Bool
  faculty : Rupa → Bool
  /-- chapter 7's categories: each member by its nature -/
  papa : PapaCat → List (List Cetasika)
  missaka : MissakaCat → List (List Dhamma)
  bodhi : BodhiCat → List (List Dhamma)
  sabba : SabbaCat → List (List Dhamma)
  /-- the members of the mind-object base -/
  dhammayatana : List Dhamma
  /-- the subjects of calm, grouped -/
  kammatthana : List (List Kammatthana)
  /-- which jhāna a subject reaches (n = 6 the immaterial) -/
  kjhana : Kammatthana → Nat → Bool

/-- The six doors (Saṅgaha ch. 3 §35, `abh07t.nrf.xml:965`). Six BY THE TYPE. -/
inductive Door | eye | ear | nose | tongue | body | mind deriving DecidableEq, Repr

/-- An object's time, relative to the citta that takes it (§51–52, `:1045–1049`): present, past, future, time-free. -/
inductive When | present | past | future | timeless deriving DecidableEq, Repr

inductive Sign | kamma | kammaNimitta | gatiNimitta deriving DecidableEq, Repr

/-- An object's desirability (ch. 4 §25–27, `:1337–1345`): undesirable, desirable, very desirable. -/
inductive Desir | anittha | ittha | atiittha deriving DecidableEq, Repr

/-- The mind-object's members by kind (ch. 3 §50, `:1041`). -/
inductive MObj | rupa (r : Rupa) | citta | cetasika (x : Cetasika) | nibbana | pannatti deriving DecidableEq, Repr

/-- Whose process it is: a worldling, a noble person short of arahantship, an arahant. -/
inductive Person | worldling | noble | arahant deriving DecidableEq, Repr

inductive PKind | fiveDoor | mindDoor | absorption | path deriving DecidableEq, Repr

structure Step where
  citta : Citta
  kicca : Kicca
  door : Option Door := none
  obj : Obj := .kamaOther
  when : When := .present
  abhinna : Bool := false
  sign : Option Sign := none
  objBase : Nat := 0
  deriving DecidableEq, Repr

structure Process where
  kind : PKind
  door : Door
  past : Nat := 0
  clear : Bool := true
  nearDeath : Bool := false
  first : Bool := false
  plane : Bhumi := .kama
  person : Person := .worldling
  desirable : Desir := .ittha
  /-- the being (its `id` in the world's `Mat.beings`) whose process this is, when it is recorded -/
  being : Option Nat := none
  steps : List Step

structure Meeting where
  door : Door
  intact : Bool
  inRange : Bool
  attended : Bool
  follows : List Step

/-- What a world has, process by process. -/
structure Proc where
  procs : List Process
  /-- which organ, if any, each door is -/
  organ : Door → Option Rupa
  /-- the members of the mind-object -/
  mindObject : List MObj
  meetings : List Meeting

/-- The cases in which a being does not breathe, besides the two spheres: `normal` is none of them. -/
inductive BreathCase | normal | womb | water | swoon | dead | fourthJhana | cessation deriving DecidableEq, Repr

/-- A being: the sphere it lives in and the matter-bases it has, by kind. -/
structure Being where
  id : Nat
  plane : Bhumi
  bases : List Rupa
  /-- whether the being has mind, whether it has matter, and its material faculties -/
  hasMind : Bool := true
  hasMatter : Bool := true
  faculties : List Rupa := []
  /-- the kinds of matter the being's body has -/
  kinds : List Rupa := []
  /-- whether it breathes, and which of the seven cases it is in -/
  breathes : Bool := false
  breathCase : BreathCase := .normal
  deriving DecidableEq, Repr

structure Kalapa where
  members : List Rupa
  origin : Origin
  life : Nat
  owner : Option Nat
  bound : Bool
  /-- the place it arises at and stays at for its whole life (a single field by the type: it has no second place, so "going" is another kalāpa at another place) -/
  place : Nat := 0
  /-- its size in paramāṇu (the Visuddhimagga-ṭīkā: a kalāpa is of paramāṇu size) -/
  size : Nat := 1
  deriving DecidableEq, Repr

/-- What a world has of matter. `reached`: the doors whose objects are taken by reaching. -/
structure Mat where
  beings : List Being
  kalapas : List Kalapa
  reached : List Door
  /-- the space between kalāpas, as pairs of their positions in `kalapas` -/
  gaps : List (Nat × Nat) := []
  /-- the size ladder's ratios, paramāṇu to aṅgula -/
  ladder : List Nat := [36, 36, 36, 36, 7, 7, 7]

/-- The three sub-moments of a mind-moment. -/
inductive Phase | arise | stand | dissolve deriving DecidableEq, Repr

/-- Matter placed in a stream. -/
structure Link (S : Scale) where
  s : Stream S
  K : Type
  origin : K → Origin
  mom : K → s.M
  phase : K → Phase
  rebirth : s.M → Prop
  produces : s.M → Prop
  embodied : s.M → Prop
  /-- death citta -/
  death : s.M → Prop := fun _ => False
  /-- concretely produced matter, as opposed to the intimations and the characteristics -/
  concrete : K → Bool := fun _ => true
  /-- where an occurrence ceases: the mind-moment and the sub-moment of its dissolution -/
  ceaseMom : K → s.M
  ceasePhase : K → Phase
  /-- the neither-perception moment before a cessation attainment, and the fruition citta that emerges -/
  cessation : s.M → Prop := fun _ => False
  /-- an arahant's last death citta: no rebirth-linking citta follows it -/
  parinibbana : s.M → Prop := fun _ => False
  fruition : s.M → Prop := fun _ => False
  /-- a sense-consciousness: its base (the organ) and its object, as occurrences -/
  sense : s.M → Prop := fun _ => False
  base : s.M → Option K := fun _ => none
  object : s.M → Option K := fun _ => none

/-- Steps of proximity: `Steps prox n m m'` — m' is n proximity-steps after m. -/
inductive Steps {M : Type} (prox : M → M → Prop) : Nat → M → M → Prop
  | zero (m : M) : Steps prox 0 m m
  | succ {n : Nat} {m a b : M} : Steps prox n m a → prox a b → Steps prox (n + 1) m b

/-- One occurrence: mind, matter or a concept (`kind`), with `rise` and `fall` the clock readings (on the world's scale) at which it arises and at which it ceases. -/
structure Occ (S : Scale) where
  kind : Kind
  rise : S.T
  fall : S.T
  /-- the citta it belongs to (a mental state) or is originated by (mind-born matter): occurrences with one `cit` are of one citta -/
  cit : Nat := 0
  /-- the citta-type, for a mind occurrence -/
  citta : Option Citta := none
  /-- the kind of matter, for a matter occurrence -/
  rupa : Option Rupa := none
  /-- the origin, for a matter occurrence -/
  born : Option Origin := none
  /-- the function a mental occurrence performs in its process (javana, registration …), when it is recorded -/
  kicca : Option Kicca := none

/-- A world's conditioning: its occurrences, and the facts `(c, i, j)`: condition `c` holds from the occurrence at index `i` of `occs` to the one at index `j` (indices into `occs`, counted from 0; they are not `cit` values). -/
structure CondW (S : Scale) where
  occs : List (Occ S)
  holds : List (Condition × Nat × Nat)

structure Reck (S R : Scale) where
  s : Stream S
  f : S.T → R.T
  cessation : s.M → Prop
  night : R.T
  week : R.T
  snap : R.T

/-- Steps of proximity that pass through no cessation moment (rate is of ordinary mind, not of the gap of a cessation): `StepsFree blocked prox n m b`. -/
inductive StepsFree {M : Type} (blocked : M → Prop) (prox : M → M → Prop) : Nat → M → M → Prop
  | zero (m : M) : StepsFree blocked prox 0 m m
  | succ {n : Nat} {m a b : M} : StepsFree blocked prox n m a → prox a b → ¬ blocked a → StepsFree blocked prox (n + 1) m b

/-- A conditioning world with a stream; `mom i` is the moment occurrence i is, when it is a citta. -/
structure Joined (S : Scale) where
  w : CondW S
  s : Stream S
  mom : Nat → Option s.M

/-- What a world says of the cosmos. -/
structure Cosmos where
  sunk : Nat
  risen : Nat
  sineruLength : Nat
  sineruWidth : Nat
  oceanDepth : Nat
  /-- length, breadth, height in yojanas -/
  moon : Nat × Nat × Nat
  sun : Nat × Nat × Nat
  /-- height above the earth of each disc's lower edge -/
  moonBottom : Nat
  sunBottom : Nat
  cakkavala : Nat
  litContinents : Nat
  /-- yojanas a day the sun gains on the moon -/
  dayGain : Nat
  /-- the number of planes in each of the four spheres: states of loss, happy sense, fine-material, immaterial -/
  planes : List Nat
  /-- how many human years are one day and night of the Four Great Kings, of the Yāma devas -/
  kingsDay : Nat
  yamaDay : Nat
  /-- the life-span in human years of the k-th sense deva realm, k = 0 the Four Great Kings -/
  lifespan : Nat → Nat
  kappaPhases : Nat
  /-- the highest of the sixteen fine-material planes (counted from 1) that each destruction reaches -/
  fireReaches : Nat
  waterReaches : Nat
  windReaches : Nat
  /-- how many buddha-fields one destruction ruins -/
  destroyedFields : Nat
  /-- the life-span of each of the twenty fine-material and immaterial planes, in SIXTHS of a kappa, in the Saṅgaha's order (the first-jhāna planes, the second, the third, Vehapphala and the non-percipient, the five Pure Abodes, the four immaterial) -/
  planeLife : List Nat

/-- The sorts a thing can be: the four ultimates, and the concept (*paññatti*). -/
inductive Sort5 | citta | cetasika | rupa | nibbana | pannatti deriving DecidableEq, Repr

/-- The six designations of the Puggalapaññatti commentary, of which only the one by a thing's own nature (*tajjā*) names something real. -/
inductive Designation | derivation | relative | collection | placing | ownNature | continuity deriving DecidableEq, Repr

/-- The three spaces: delimiting space, space removed by a kasiṇa, unentangled space. -/
inductive Space | delimiting | kasina | unentangled deriving DecidableEq, Repr

/-- The twelve links of dependent origination. -/
inductive Link12 | ignorance | formations | consciousness | mindMatter | sixBases | contact | feeling | craving | clinging | becoming | birth | decayDeath
  deriving DecidableEq, Repr

/-- What a world says of status. -/
structure Status where
  ultimates : List Sort5
  timeFree : List Sort5
  spaceSort : Space → Sort5
  realDesignation : Designation → Bool
  nibbanaConditioned : Bool
  nibbanaCount : Nat
  /-- what direction and time are designated on, by the sort they are -/
  timeSort : Sort5
  /-- dependent origination: the links in order, and how many fall in each of the three periods -/
  chain : List Link12
  periods : List Nat
  modes : Nat
  connections : Nat
  groups : Nat
  rounds : Nat
  roots : Nat

/-- The ONE World. `s` is the stream; the matter placed in it, the day-reckoning, the conditioning facts and their map to moments are all over `s`. -/
structure World (S R : Scale) where
  /-- the one stream of mind-moments; its clock readings are on the scale `S` -/
  s : Stream S
  /-- the pieces of matter placed in the stream (a type of them): each has an origin, the mind-moment it arises with, and the sub-moment (arise, stand or dissolve) at which it arises -/
  K : Type
  origin : K → Origin
  mom : K → s.M
  phase : K → Phase
  /-- facts about a mind-moment: it is a rebirth-linking moment · it is a moment that produces new kamma-born matter · the being it belongs to is embodied (has matter) -/
  rebirth : s.M → Prop
  produces : s.M → Prop
  embodied : s.M → Prop
  /-- the moment is a death moment · the neither-perception moment just before a cessation attainment · an arahant's final death moment (no rebirth follows) · a fruition moment -/
  death : s.M → Prop
  cessation : s.M → Prop
  parinibbana : s.M → Prop
  fruition : s.M → Prop
  /-- the piece is concretely produced matter (as opposed to the intimations and the characteristics) -/
  concrete : K → Bool
  /-- the mind-moment and sub-moment at which the piece ceases -/
  ceaseMom : K → s.M
  ceasePhase : K → Phase
  /-- the moment is a sense-consciousness; if so, `base` is the piece it arises in (its organ) and `object` the piece it takes -/
  sense : s.M → Prop
  base : s.M → Option K
  object : s.M → Option K
  /-- the second clock: the ordinary day-reckoning `R`, laid on the stream by `f` (from a stream reading to a day-reckoning reading); `night`, `week` and `snap` are lengths on it (a night, a week, a finger-snap) -/
  f : S.T → R.T
  night : R.T
  week : R.T
  snap : R.T
  /-- conditioning: the occurrences, and the facts `(c, i, j)`: condition `c` holds from the occurrence at INDEX `i` of `cond.occs` to the one at INDEX `j` (indices into that list, counted from 0; not `cit` values) -/
  cond : CondW S
  /-- which mind-moment of the stream the occurrence at a given index of `cond.occs` is, when it is a citta -/
  momOf : Nat → Option s.M
  /-- bodies and kalāpas, processes, the taxonomy, the cosmos, the status -/
  mat : Mat
  proc : Proc
  tax : Tax
  cosmos : Cosmos
  status : Status

end V

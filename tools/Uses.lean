/-
  Uses.lean — the instrument behind `kala/THEOREMS.md` (scripts/theorems-index.py; founder 2026-10-13, /prove).

  `#theorems_report`, placed at the END of a Lean file that imports this module, prints one JSON line per theorem the
  file declares: its hypotheses split into USED and UNUSED by the elaborated proof term, the Lean axioms it rests on
  (propext · Quot.sound · Classical.choice · sorryAx), its docstring and its line. Nothing here is declared by hand:
  "which axioms did this proof use" is READ from Lean, never written down by whoever wrote the proof.

  A hypothesis is a binder whose type is a Prop; it is USED iff the proof body (after the binders) contains it.
  ⭐ An UNUSED hypothesis is a finding about the derivation, not a tidiness warning (9/30: a between ends when EITHER
  neighbour ends — Lean flagged the second bound). Binders named with an axiom ID (`a112_link`, `c_conditioned`) map
  to that ID in THEOREMS.md; that naming is the /prove convention.
-/
import Lean
open Lean Elab Command Meta

namespace FormalAbhidhamma.Tools

/-- Auto-generated companions of a declaration (recursors, `casesOn`, `noConfusion` …): never an author's definition. -/
def isAuto (n : Name) : Bool :=
  n.isInternal || match n with
    | .str _ s => ["rec", "recOn", "casesOn", "noConfusion", "noConfusionType", "brecOn", "below", "ibelow", "binductionOn",
                   "mk", "inj", "injEq", "sizeOf_spec", "ctorIdx", "toCtorIdx", "ofNat"].contains s || s.startsWith "match_"
                   || s.startsWith "proof_" || s.startsWith "eq_" || s.startsWith "_"
    | _ => false

/-- Every DEFINITION of this repo (namespace `FormalAbhidhamma`) the theorem reaches, through its statement, its proof and
    every lemma of ours the proof calls. Theorems are traversed, not listed; a constructor is listed as its type. These
    are what `AXIOMS.md`'s Lean column names (`Stream.one_at_a_time` = A1, `lifespan` = A4 …). -/
partial def reaches (root : Name) : MetaM (Array String) := do
  let env ← getEnv
  let mut seen : NameSet := {}
  let mut out : Array String := #[]
  let mut todo : Array Name := #[root]
  while h : todo.size > 0 do
    let n := todo[todo.size - 1]
    todo := todo.pop
    if seen.contains n then continue
    seen := seen.insert n
    let some ci := env.find? n | continue
    if !(`FormalAbhidhamma).isPrefixOf n then continue
    let n' := match ci with | .ctorInfo c => c.induct | _ => n
    -- A Prop-valued structure FIELD (`Stream.one_at_a_time`, A1) is a theorem-kind projection: list it, because the
    -- field IS the axiom. Other theorems are traversed, not listed.
    let listed := match ci with
      | .thmInfo _ => env.isProjectionFn n
      | _ => true
    if listed && n != root && !isAuto n' && !out.contains n'.toString then out := out.push n'.toString
    let mut next := ci.type.getUsedConstants
    if let some v := ci.value? (allowOpaque := true) then next := next ++ v.getUsedConstants
    if let .thmInfo t := ci then next := next ++ t.value.getUsedConstants
    if let .ctorInfo c := ci then next := next.push c.induct
    for m in next do
      if !seen.contains m then todo := todo.push m
  return out

/-- The report for one theorem, as a single JSON object. -/
def reportOne (n : Name) (v : Expr) : MetaM Json := do
  let env ← getEnv
  let ax ← collectAxioms n
  let doc ← findDocString? env n
  let line := match ← findDeclarationRanges? n with
    | some r => r.range.pos.line
    | none => 0
  -- Only the binders of the theorem's own STATEMENT count: the proof's internal lambdas (an `intro` for a `¬ P`
  -- conclusion, say) are not hypotheses. `Not` is not unfolded, so a negated conclusion keeps its premise inside.
  let k ← forallTelescope (← getConstInfo n).type fun ys _ => pure ys.size
  lambdaBoundedTelescope v k fun xs body => do
    let mut used : Array String := #[]
    let mut unused : Array String := #[]
    for x in xs do
      let d ← x.fvarId!.getDecl
      if ← isProp d.type then
        let nm := d.userName.eraseMacroScopes.toString
        if body.containsFVar x.fvarId! then used := used.push nm
        else unused := unused.push nm
    let defs ← reaches n
    return Json.mkObj [
      ("name", toJson n.toString), ("line", toJson line), ("used", toJson used), ("unused", toJson unused),
      ("defs", toJson defs),
      ("axioms", toJson (ax.map (·.toString))), ("doc", toJson (doc.getD ""))]

/-- `#theorems_report` — one `THEOREM_JSON {…}` line per theorem declared in THIS file. -/
elab "#theorems_report" : command => liftTermElabM do
  let env ← getEnv
  let mut out : Array (Nat × String) := #[]
  for (n, ci) in env.constants.map₂.toList do
    if n.isInternal then continue
    if let .thmInfo t := ci then
      -- No source position = generated by Lean (equation lemmas `f.eq_1`, `f.eq_def`), never written by an author.
      if (← findDeclarationRanges? n).isNone then continue
      let j ← reportOne n t.value
      out := out.push ((j.getObjValAs? Nat "line").toOption.getD 0, j.compress)
  for (_, s) in out.qsort (fun a b => a.1 < b.1) do
    logInfo m!"THEOREM_JSON {s}"

end FormalAbhidhamma.Tools
